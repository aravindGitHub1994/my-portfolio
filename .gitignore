# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
recovery-codes.txt

# owner source assets (ADR-013 §9) — reference photography, AI concept sheets,
# KML route legs and the raw originals the Gallery is built from. These are
# SOURCE: `scripts/build-pictures.mjs` emits bounded copies into
# public/pictures/ and that output is what ships. Ignored rather than merely
# untracked because `assets-src/workstation/tattoo01–04.jpg` must never be
# committed (ADR-012 §3) and "nobody types `git add -A`" is not a control.
/assets-src/

# confidential client screenshots (ADR-006 §7a) — raw product captures must
# never be committed; published imagery is recreated with dummy data only.
# Nothing under docs/projects/ is ever a publishable image: recreations are
# authored as .html here and rasterized into public/screens/.
docs/**/Screenshot*.png
docs/**/screenshot*.png
docs/projects/**/*.png
docs/projects/**/*.jpg
docs/projects/**/*.jpeg
docs/projects/**/*.webp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
